meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq healthy
  res.body.service: eq lorcana-card-manager
}

tests {
  test("Response time should be less than 500ms", function() {
    expect(res.getResponseTime()).to.be.below(500);
  });
  
  test("Should return JSON", function() {
    expect(res.getHeader('content-type')).to.contain('application/json');
  });
}
