meta {
  name: Get Non-Existent Image
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}{{apiPrefix}}/images/999999
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.detail: contains not found
}

tests {
  test("Should return 404 for non-existent image", function() {
    expect(res.status).to.equal(404);
  });
}

docs {
  # Get Non-Existent Image
  
  Test error handling for non-existent image IDs.
  Should return 404 Not Found.
}
