meta {
  name: Upload Image
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/images/upload
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(./test-data/test_card.png)
}

assert {
  res.status: eq 201
  res.body.image_id: isDefined
  res.body.status: eq non_traite
  res.body.message: eq Image uploaded successfully
}

tests {
  test("Should return image_id", function() {
    expect(res.body.image_id).to.be.a('number');
    expect(res.body.image_id).to.be.greaterThan(0);
  });
  
  test("Should have correct status", function() {
    expect(res.body.status).to.equal('non_traite');
  });
  
  // Store image_id for next requests
  bru.setVar("lastImageId", res.body.image_id);
}

docs {
  # Upload Image
  
  Upload a card image file for OCR processing.
  
  **Accepted formats**: JPG, PNG
  **Max size**: 10MB
  
  ## Response
  
  Returns the created image ID and initial status.
}
